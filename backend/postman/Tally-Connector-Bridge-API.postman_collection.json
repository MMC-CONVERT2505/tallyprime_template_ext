          ]
        },
        {
          "name": "Create Extraction — connectionId not online (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"connectionId\": \"{{connectionId}}\",\n  \"type\": \"GROUPS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/extractions", "host": ["{{baseUrl}}"], "path": ["extractions"] },
            "description": "Run this against a connectionId with no bridge currently connected (check List Connections first) to reproduce \"This connector is not currently online.\" — jobs are rejected immediately rather than queued to fail later."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request (if offline) or 202 (if actually online)', () => pm.expect([202, 400]).to.include(pm.response.code));",
                  "if (pm.response.code === 400) {",
                  "  pm.test('explains why', () => pm.expect(pm.response.json().message).to.include('not currently online'));",
                  "}"
                ]
              }
            }
          ]
        }
