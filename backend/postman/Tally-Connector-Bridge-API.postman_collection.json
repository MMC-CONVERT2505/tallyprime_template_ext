        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/extractions/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["extractions", "{{jobId}}"] },
            "description": "Poll this (re-send) until status flips from PENDING to SUCCESS or FAILED — uses whichever jobId was set by the most recently run Create/Fetch Master request above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "console.log('status =', body.status, ' recordCount =', body.recordCount, ' error =', body.error);",
                  "pm.test('status is a known value', () => pm.expect(['PENDING','SUCCESS','FAILED']).to.include(body.status));"
