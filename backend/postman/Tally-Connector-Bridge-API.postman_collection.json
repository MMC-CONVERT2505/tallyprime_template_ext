    {
      "name": "7. Negative / Error-Path Tests",
      "item": [
        {
          "name": "Fetch Master — Unknown Company (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"This Company Does Not Exist Pvt Ltd\",\n  \"masterType\": \"GROUPS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/extractions/fetch-master", "host": ["{{baseUrl}}"], "path": ["extractions", "fetch-master"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('message explains why', () => pm.expect(pm.response.json().message).to.include('No active connector'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch Master — Missing masterType (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"{{tallyCompanyName}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/extractions/fetch-master", "host": ["{{baseUrl}}"], "path": ["extractions", "fetch-master"] },
            "description": "Validates the global ValidationPipe (whitelist + forbidNonWhitelisted) rejects an incomplete DTO with a 400, not a 500."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Extractions — Nonexistent Job (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/extractions/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["extractions", "00000000-0000-0000-0000-000000000000"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }
          ]
