          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK, spreadsheet content-type', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('spreadsheetml'); });"] } }
          ]
