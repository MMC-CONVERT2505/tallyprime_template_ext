              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/extractions/fetch-master", "host": ["{{baseUrl}}"], "path": ["extractions", "fetch-master"] },
            "description": "fromDate/toDate here are ISO YYYY-MM-DD (converted internally to Tally's YYYYMMDD) — different convention from the Tally Direct folder's raw endpoints."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('jobId', body.id);",
                  "pm.collectionVariables.set('ledgersJobId', body.id);",
                  "console.log('ledgersJobId =', body.id);"
                ]
              }
            }
          ]
        },
