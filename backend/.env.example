# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# All routes are served under this prefix, e.g. GET /api/health
APP_GLOBAL_PREFIX=api

# ─────────────────────────────────────────────────────────────
# Tally connectivity (the machine running TallyPrime)
# ─────────────────────────────────────────────────────────────
# Where TallyPrime's HTTP/XML server is listening.
# In dev the backend usually runs on the SAME machine/network as Tally.
# Enable it in Tally: F1 (Help) -> Settings -> Connectivity -> "Act as Server", port 9001.
TALLY_HOST=127.0.0.1
TALLY_PORT=9001
# Request timeout. Tally can be slow on large companies / wide date ranges.
# Prefer chunking by month over raising this too high.
TALLY_TIMEOUT_MS=60000
# Charset Tally responds with. TallyPrime is usually utf-8; older Tally.ERP 9
# builds emit windows-1252 / ISO-8859-1. Set this if you see mangled £/é/etc.
# Accepted: utf-8 | latin1 | win1252 | ascii (or leave as auto to trust the header)
TALLY_RESPONSE_ENCODING=auto
# Optional default company (exact name as shown in Tally) used when a request omits it.
TALLY_DEFAULT_COMPANY=
# Extra attempts (beyond the first) on transient errors (timeout/unreachable). 0 disables retrying.
TALLY_MAX_RETRIES=2
# Exponential backoff base for retries, e.g. 500ms -> 500ms, 1000ms, 2000ms, ...
TALLY_RETRY_BASE_MS=500
# Wider VOUCHERS (Day Book) requests are auto-split into chunks of at most
# this many days, so a wide date range doesn't time out in one request.
TALLY_VOUCHER_CHUNK_DAYS=7
# Pause between successive chunk/batch requests (VOUCHERS date-chunks and
# LEDGERS/STOCK_ITEMS name-batches below) so back-to-back calls don't hammer
# Tally's single-request-at-a-time HTTP server. 0 disables the pause.
TALLY_CHUNK_DELAY_MS=2000
# LEDGERS/STOCK_ITEMS collections larger than this many records are
# auto-split into name-range sub-requests of at most this size, instead of
# one unbounded request that can make Tally hang on a large chart of
# accounts. A company at or under this size is unaffected (single request,
# same as always).
TALLY_MASTER_BATCH_SIZE=300
# Batch size for LEDGERS/STOCK_ITEMS requests that ALSO specify a
# fromDate/toDate period. Defaults to 4, bisected live against a real Tally
# instance (4 consistently fine, 10 consistently wedged Tally). This is
# SEPARATE from Tally's own reserved/system ledgers (e.g. "Profit & Loss
# A/c"), which wedge Tally on a period-scoped balance request even
# completely alone — those are excluded from period-scoped batches
# entirely (src/tally/extraction/master-extraction.service.ts), not sized
# around. Only raise this after re-bisecting against your own Tally
# instance — see TallyConfig.periodBatchSize for the full writeup.
TALLY_PERIOD_BATCH_SIZE=4
# Circuit breaker for a genuinely wedged Tally (not just one flaky call) —
# see TallyConfig.circuitBreakerThreshold for the full writeup and the live
# incident that motivated it. After this many CONSECUTIVE requests fail with
# a timeout/unreachable error, further requests fail immediately with an
# actionable message instead of each independently waiting out
# TALLY_TIMEOUT_MS to rediscover the same hang.
TALLY_CIRCUIT_BREAKER_THRESHOLD=2
# How long the circuit stays open (failing fast) before the next request is
# let through again to test whether Tally has recovered.
TALLY_CIRCUIT_OPEN_MS=15000

# ─────────────────────────────────────────────────────────────
# PostgreSQL (identity + job/audit state)
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tally
DB_PASSWORD=tally
DB_NAME=tally_migration
# Log every Prisma query. Dev-only.
DB_LOGGING=false
# Optional: full connection string, overrides the DB_* fields above when set.
# Not required for the app (it builds one from DB_* automatically) but the
# Prisma CLI (`npx prisma migrate ...`) reads this directly, so it must be set
# for local migrations. Keep in sync with DB_* above, or just set this and
# ignore DB_* if you'd rather have one source of truth.
DATABASE_URL=postgresql://tally:tally@127.0.0.1:5432/tally_migration
DB_LOGGING=false

# ─────────────────────────────────────────────────────────────
# Redis (cache + health; later: BullMQ queue + socket.io adapter)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Local dev only — generate a fresh one per real environment
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Never reuse this value in staging/production.
JWT_SECRET=c91db6b6042020e788a70176fef59773b7c3d3292a01fa7c1dd180e35f6ce694
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────────────────────
# Agent<->Gateway tunnel (docs/architecture.md Phase 3)
# ─────────────────────────────────────────────────────────────
# Server side: nothing to set — device credentials now live in Postgres
# (TallyConnection), issued per-connection via POST /connections.
# Agent side (this is what goes in the CONNECTOR's own .env, not the server's):
AGENT_TOKEN=2693c196-b8b3-453b-9168-7f35e864f105.3c4c7582214c078c7430bed27d63d8262b077cbaed31ade040bf38e8103df074
# GATEWAY_URL=ws://127.0.0.1:3000/agent-tunnel

# AGENT_TOKEN=19cf9e5c-63eb-4c19-8690-e60cefd3e070.19f9df46aa7c85c2f8776c35850db7018f1015c5a990447e8a4eca30f0405235
# ^ cleared 2026-08-11: belonged to an orphaned test org, not admin@mmcconvert.com's.
# Leaving unset so the agent auto-pairs fresh on next boot and prints a new userCode to approve.

# ─────────────────────────────────────────────────────────────
# Extraction jobs (docs/architecture.md Phase 4)
# ─────────────────────────────────────────────────────────────
# How long a completed job's result stays fetchable from Redis before expiring.
EXTRACTION_RESULT_TTL_SECONDS=3600

# SMTP for job-complete notifications — all optional. Leave SMTP_HOST empty to
# skip sending entirely (jobs still complete normally; no email goes out).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# ─────────────────────────────────────────────────────────────
# Bulk export (BulkExportService — every Zoho-mapped entity for one
# company: GROUPS/LEDGERS/STOCK_ITEMS/COST_CENTRES +
# Sales/Purchase/Credit Note/Stock Journal vouchers, all 9 Zoho templates
# generated and zipped in one request)
# ─────────────────────────────────────────────────────────────
# Where generated .zip files are written (relative to the backend's working
# directory unless absolute). Holds real customer financial data
# (GSTIN/PAN/bank details) at rest — never served as static/unauthenticated
# content; download always goes through the authenticated
# GET /extractions/bulk-export/:id/download route.
EXPORTS_DIR=public/exports
# How long a single step (one master/voucher extraction job within the bulk
# export) is polled before the whole run is given up on as stuck.
BULK_EXPORT_STEP_TIMEOUT_MS=1200000
# How often a still-PENDING step's job status is re-checked.
BULK_EXPORT_POLL_INTERVAL_MS=2000
# How long a completed export's status/step record stays readable — kept
# roughly as long as the zip itself stays on disk (see RETENTION_HOURS below).
BULK_EXPORT_RECORD_TTL_SECONDS=604800
# Zips older than this are opportunistically deleted the next time a bulk
# export starts.
BULK_EXPORT_RETENTION_HOURS=168
