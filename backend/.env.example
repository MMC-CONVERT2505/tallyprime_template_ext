# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# All routes are served under this prefix, e.g. GET /api/health
APP_GLOBAL_PREFIX=api

# ─────────────────────────────────────────────────────────────
# Tally connectivity (the machine running TallyPrime)
# ─────────────────────────────────────────────────────────────
# Where TallyPrime's HTTP/XML server is listening.
# In dev the backend usually runs on the SAME machine/network as Tally.
# Enable it in Tally: F1 (Help) -> Settings -> Connectivity -> "Act as Server", port 9000.
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
# Request timeout. Tally can be slow on large companies / wide date ranges.
# Prefer chunking by month over raising this too high.
TALLY_TIMEOUT_MS=60000
# Charset Tally responds with. TallyPrime is usually utf-8; older Tally.ERP 9
# builds emit windows-1252 / ISO-8859-1. Set this if you see mangled £/é/etc.
# Accepted: utf-8 | latin1 | win1252 | ascii (or leave as auto to trust the header)
TALLY_RESPONSE_ENCODING=auto
# Optional default company (exact name as shown in Tally) used when a request omits it.
TALLY_DEFAULT_COMPANY=

# ─────────────────────────────────────────────────────────────
# PostgreSQL (identity + job/audit state)
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tally
DB_PASSWORD=tally
DB_NAME=tally_migration
# Log every Prisma query. Dev-only.
DB_LOGGING=false
# Optional: full connection string, overrides the DB_* fields above when set.
# Not required for the app (it builds one from DB_* automatically) but the
# Prisma CLI (`npx prisma migrate ...`) reads this directly, so it must be set
# for local migrations. Keep in sync with DB_* above, or just set this and
# ignore DB_* if you'd rather have one source of truth.
DATABASE_URL=postgresql://tally:tally@127.0.0.1:5432/tally_migration
DB_LOGGING=false

# ─────────────────────────────────────────────────────────────
# Redis (cache + health; later: BullMQ queue + socket.io adapter)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Local dev only — generate a fresh one per real environment
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Never reuse this value in staging/production.
JWT_SECRET=c91db6b6042020e788a70176fef59773b7c3d3292a01fa7c1dd180e35f6ce694
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────────────────────
# Agent<->Gateway tunnel (docs/architecture.md Phase 3)
# ─────────────────────────────────────────────────────────────
# Server side: nothing to set — device credentials now live in Postgres
# (TallyConnection), issued per-connection via POST /connections.
# Agent side (this is what goes in the CONNECTOR's own .env, not the server's):
AGENT_TOKEN=2693c196-b8b3-453b-9168-7f35e864f105.3c4c7582214c078c7430bed27d63d8262b077cbaed31ade040bf38e8103df074
# GATEWAY_URL=ws://127.0.0.1:3000/agent-tunnel

# AGENT_TOKEN=19cf9e5c-63eb-4c19-8690-e60cefd3e070.19f9df46aa7c85c2f8776c35850db7018f1015c5a990447e8a4eca30f0405235
# ^ cleared 2026-08-11: belonged to an orphaned test org, not admin@mmcconvert.com's.
# Leaving unset so the agent auto-pairs fresh on next boot and prints a new userCode to approve.

# ─────────────────────────────────────────────────────────────
# Extraction jobs (docs/architecture.md Phase 4)
# ─────────────────────────────────────────────────────────────
# How long a completed job's result stays fetchable from Redis before expiring.
EXTRACTION_RESULT_TTL_SECONDS=3600

# SMTP for job-complete notifications — all optional. Leave SMTP_HOST empty to
# skip sending entirely (jobs still complete normally; no email goes out).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
