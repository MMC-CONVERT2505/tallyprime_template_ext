datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ExtractionType {
  COMPANIES
  LEDGERS
  VOUCHERS
  RAW
  CREATE_LEDGER
  STOCK_ITEMS
}

enum ExtractionStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Audit trail for every Tally read/write the backend performs. Deliberately
/// holds only metadata (type, company, status, counts, timing) — never the raw
/// extracted financial records. See docs/architecture.md for why.
model ExtractionJob {
  id          String            @id @default(uuid())
  type        ExtractionType
  status      ExtractionStatus  @default(PENDING)
  company     String?
  params      Json
  recordCount Int?
  durationMs  Int?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("extraction_jobs")
}

/// Registry of connector installs (one per client machine/company), used once
/// the cloud-tunnel agent architecture lands (docs/architecture.md, Phase 3).
model TallyConnection {
  id             String    @id @default(uuid())
  label          String
  host           String
  port           Int
  defaultCompany String?
  isActive       Boolean   @default(true)
  lastSeenAt     DateTime?
  org            Org?      @relation(fields: [orgId], references: [id])
  orgId          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("tally_connections")
}

/// A customer account. Agent pairing (Phase 3) and future multi-user access
/// are both scoped to an Org, not to an individual User.
model Org {
  id          String            @id @default(uuid())
  name        String
  users       User[]
  connections TallyConnection[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("orgs")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  org          Org      @relation(fields: [orgId], references: [id])
  orgId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
